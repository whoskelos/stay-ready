---
import type { IconName } from '../lib/icons';
import IconBadge from './IconBadge.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  eyebrow: string;
  title: string;
  highlight?: string;
  subtitle?: string;
  services: { title: string; description?: string; icon: IconName }[];
}

const { eyebrow, title, highlight, subtitle, services } = Astro.props;
---

<section id="soluciones" aria-labelledby="soluciones-title" class="py-20 sm:py-24">
  <div class="mx-auto max-w-(--container-page) px-4 sm:px-6">
    <SectionHeading {eyebrow} {title} {highlight} {subtitle} id="soluciones-title" />

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service, index) => (
          <li data-reveal style={`--reveal-delay:${Math.min(index, 5) * 70}ms`}>
            <article class="h-full rounded-(--radius-card) border border-line bg-card p-7">
              <IconBadge name={service.icon} shape="rounded" size="size-12" />
              <h3 class="mt-6 font-display text-lg font-semibold">{service.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{service.description}</p>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
