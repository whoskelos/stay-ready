---
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';

interface Props {
  /** Muestra solo la gota, sin el nombre. */
  iconOnly?: boolean;
  class?: string;
  /** Nombre de la empresa: la última palabra se muestra en teal. */
  name: string;
}

const { iconOnly = false, class: className = '', name } = Astro.props;
const words = name.trim().split(/\s+/);
const lastWord = words.pop() ?? '';
const firstWords = words.join(' ');
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <!-- Doble de densidad respecto al tamaño mostrado (h-10) para pantallas retina -->
  <Image src={logo} alt="" width={66} height={80} class="h-10 w-auto" />
  {
    !iconOnly && (
      <span class="font-display text-lg leading-none font-bold tracking-wide text-navy uppercase">
        {firstWords && `${firstWords} `}
        <span class="text-teal-text">{lastWord}</span>
      </span>
    )
  }
</span>
