---
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props {
  nav: { label: string; href: string }[];
  phone: string;
  callHref: string;
  callLabel: string;
  name: string;
  a11y: { mainNav: string; mobileNav: string; openMenu: string; homeLink: string };
}

const { nav, phone, callHref, callLabel, name, a11y } = Astro.props;
---

<!-- Fijo arriba; al hacer scroll `data-scrolled` lo convierte en píldora flotante -->
<header
  id="site-header"
  class="group fixed inset-x-0 top-0 z-40 transition-[padding] duration-300 data-[scrolled]:px-4 data-[scrolled]:pt-3 motion-reduce:transition-none sm:data-[scrolled]:px-6"
>
  <div
    class="mx-auto flex max-w-(--container-page) items-center justify-between gap-4 bg-transparent px-4 py-2 transition-[border-radius,background-color,box-shadow] duration-300 group-data-[scrolled]:rounded-full group-data-[scrolled]:bg-white/90 group-data-[scrolled]:shadow-card group-data-[scrolled]:backdrop-blur-md motion-reduce:transition-none sm:px-6"
  >
    <a href="#inicio" aria-label={`${name}. ${a11y.homeLink}`} class="shrink-0">
      <Logo {name} />
    </a>

    <nav aria-label={a11y.mainNav} class="hidden lg:block">
      <ul class="relative flex items-center gap-1 rounded-full bg-white/65 p-1 backdrop-blur-md transition-colors group-data-[scrolled]:bg-transparent group-data-[scrolled]:backdrop-blur-none motion-reduce:transition-none">
        <li id="nav-pill" role="presentation" aria-hidden="true" class="pointer-events-none absolute top-0 left-0 rounded-full bg-surface opacity-0 data-[ready]:transition-[transform,width] data-[ready]:duration-350 data-[ready]:ease-[cubic-bezier(0.22,1,0.36,1)] motion-reduce:data-[ready]:transition-none"></li>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-flex min-h-11 items-center rounded-full px-3 text-sm whitespace-nowrap font-medium text-navy transition-colors duration-300 ease-out motion-reduce:transition-none relative z-10 hover:bg-surface hover:text-navy"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={callHref}
        aria-label={`${callLabel}: ${phone}`}
        class="inline-flex min-h-11 items-center gap-2 rounded-full bg-navy px-4 text-sm whitespace-nowrap font-semibold text-white transition-colors hover:bg-ink sm:px-5 max-sm:size-11 max-sm:justify-center max-sm:px-0"
      >
        <Icon name="phone" class="size-4" />
        <span class="hidden sm:inline">{callLabel}</span>
      </a>
      <!-- Menú móvil con el atributo nativo `popover`: sin librerías ni estado en JS -->
      <button
        type="button"
        popovertarget="mobile-menu"
        aria-label={a11y.openMenu}
        class="inline-flex size-11 items-center justify-center rounded-full bg-white/70 text-navy transition-colors hover:bg-surface group-data-[scrolled]:bg-transparent group-data-[scrolled]:hover:bg-surface lg:hidden"
      >
        <Icon name="menu" class="size-6" />
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    popover
    aria-label={a11y.mobileNav}
    class="fixed top-20 right-4 bottom-auto left-4 m-0 w-auto rounded-3xl border border-line bg-card p-3 shadow-card sm:right-6 sm:left-auto sm:w-80 lg:hidden"
  >
    <ul>
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="flex min-h-11 items-center rounded-2xl px-4 font-medium text-navy transition-colors duration-300 ease-out motion-reduce:transition-none hover:bg-surface aria-[current=true]:bg-surface"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  const menu = document.getElementById('mobile-menu');

  // Umbral pequeño: la píldora aparece en cuanto el usuario empieza a bajar.
  const update = () => header?.toggleAttribute('data-scrolled', window.scrollY > 24);
  update();
  window.addEventListener('scroll', update, { passive: true });

  // Scroll-spy: marca con `aria-current` el enlace de la sección que está en pantalla.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('#site-header nav a[href^="#"]')];
  const sections = [...new Set(links.map((link) => link.getAttribute('href')!.slice(1)))]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  // Pill deslizante del menú de escritorio: se mueve y cambia de ancho hacia el enlace activo.
  const pill = document.getElementById('nav-pill');
  let pillReady = false;
  const movePill = () => {
    const active = document.querySelector<HTMLElement>('#site-header nav:not(#mobile-menu) a[aria-current]');
    if (!pill || !active || active.offsetWidth === 0) return;
    pill.style.width = `${active.offsetWidth}px`;
    pill.style.height = `${active.offsetHeight}px`;
    pill.style.transform = `translate(${active.offsetLeft}px, ${active.offsetTop}px)`;
    pill.style.opacity = '1';
    if (!pillReady) {
      // Primera colocación sin animar; las siguientes sí se deslizan.
      pillReady = true;
      requestAnimationFrame(() => pill.setAttribute('data-ready', ''));
    }
  };

  const markCurrent = () => {
    // Línea de lectura: un tercio de la ventana, por debajo de la cabecera.
    const line = window.innerHeight * 0.33;
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    let current = sections[0];
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= line) current = section;
    }
    if (atBottom) current = sections[sections.length - 1];
    for (const link of links) {
      if (link.getAttribute('href') === `#${current?.id}`) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    }
    movePill();
  };
  markCurrent();
  window.addEventListener('scroll', markCurrent, { passive: true });
  window.addEventListener('resize', markCurrent);

  // Cierra el menú móvil al elegir una sección
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) menu.hidePopover();
  });
</script>
