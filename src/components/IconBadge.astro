---
import type { IconName } from '../lib/icons';
import type { UiIconName } from '../lib/icon-paths';
import Icon from './Icon.astro';

interface Props {
  name: IconName | UiIconName;
  /** `brand` usa el degradado de marca; `whatsapp` el verde funcional del canal. */
  tone?: 'brand' | 'whatsapp';
  /** Clases de tamaño del círculo. */
  size?: string;
  /** Círculo completo o cuadrado con esquinas muy redondeadas. */
  shape?: 'circle' | 'rounded';
  iconClass?: string;
}

const { name, tone = 'brand', size = 'size-12', shape = 'circle', iconClass = 'size-5' } = Astro.props;
---

<span
  class:list={[
    'inline-flex shrink-0 items-center justify-center text-white shadow-icon',
    shape === 'circle' ? 'rounded-full' : 'rounded-2xl',
    tone === 'brand' ? 'bg-brand-gradient' : 'bg-whatsapp',
    size,
  ]}
>
  <Icon {name} class={iconClass} />
</span>
