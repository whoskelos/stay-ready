---
import Icon from './Icon.astro';

interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<!-- Atajo permanente al canal principal; no sustituye a la sección Contacto -->
<a
  {href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  class="fixed right-4 bottom-4 z-40 inline-flex size-14 items-center justify-center rounded-full bg-whatsapp text-white shadow-card transition-transform hover:scale-105 motion-reduce:transition-none sm:right-6 sm:bottom-6"
>
  <Icon name="chat" class="size-7" />
</a>
