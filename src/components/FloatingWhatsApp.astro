---
import Icon from './Icon.astro';

interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<!-- Atajo permanente al canal principal; no sustituye a la sección Contacto -->
<a
  {href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  class="fixed right-4 bottom-4 z-40 inline-flex size-14 items-center justify-center rounded-full bg-whatsapp text-white shadow-card transition-transform hover:scale-105 motion-reduce:transition-none motion-reduce:hover:scale-100 sm:right-6 sm:bottom-6"
>
  <!-- Halo pulsante decorativo; se desactiva con prefers-reduced-motion -->
  <span aria-hidden="true" class="absolute inset-0 rounded-full bg-whatsapp opacity-0 motion-safe:animate-pulse-ring"></span>
  <Icon name="chat" class="relative size-7" />
</a>
