---
interface Props {
  eyebrow: string;
  title: string;
  text: string;
  stats: { value: string; label: string }[];
}

const { eyebrow, title, text, stats } = Astro.props;
---

<section id="sobre-nosotros" aria-labelledby="sobre-title" class="py-20 sm:py-24">
  <div class="mx-auto max-w-(--container-page) px-4 sm:px-6">
    <!-- El degradado termina en teal oscuro (no en el teal de marca) para que el texto blanco pase AA -->
    <div
      data-reveal
      class="grid items-center gap-10 rounded-(--radius-banner) bg-linear-[120deg] from-navy via-brand-mid via-65% to-teal-text p-8 text-white sm:p-12 lg:grid-cols-2 lg:gap-16 lg:p-16"
    >
      <div>
        <p class="text-xs font-medium tracking-[0.25em] text-white/85">{eyebrow}</p>
        <h2
          id="sobre-title"
          class="mt-4 text-3xl leading-tight font-semibold text-white sm:text-4xl lg:text-5xl"
        >
          {title}
        </h2>
      </div>

      <div>
        <p class="leading-relaxed text-white/95">{text}</p>
        <dl class="mt-8 grid grid-cols-3 gap-4">
          {
            stats.map((stat) => (
              <div class="flex flex-col-reverse gap-1">
                <dt class="text-sm text-white/90">{stat.label}</dt>
                <dd class="font-display text-2xl font-semibold sm:text-3xl">{stat.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
