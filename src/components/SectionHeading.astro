---
interface Props {
  eyebrow: string;
  title: string;
  /** Parte final del titular que se muestra con degradado. */
  highlight?: string;
  subtitle?: string;
  /** Id del <h2>, para enlazarlo con `aria-labelledby` de la sección. */
  id?: string;
  align?: 'center' | 'left';
}

const { eyebrow, title, highlight, subtitle, id, align = 'center' } = Astro.props;
---

<header class:list={['max-w-2xl', align === 'center' ? 'mx-auto text-center' : 'text-left']}>
  <p class="text-xs font-medium tracking-[0.25em] text-teal-text">{eyebrow}</p>
  <h2 {id} class="mt-3 text-3xl leading-tight font-semibold sm:text-4xl">
    {title}{' '}
    {highlight && <span class="text-gradient">{highlight}</span>}
  </h2>
  {subtitle && <p class="mt-4 text-ink-soft">{subtitle}</p>}
</header>
