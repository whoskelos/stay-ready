---
// Único punto de entrada de metadatos del <head>: ninguna página repite meta tags.
interface Props {
  title: string;
  description: string;
  /** Ruta relativa de la página (p. ej. "/"). Se convierte en canonical absoluto. */
  path?: string;
  /** Ruta de la imagen Open Graph (1200×630) dentro de /public. */
  image?: string;
  /** Páginas de utilidad (404) no deben indexarse. */
  noindex?: boolean;
  /** Datos estructurados ya montados; se serializan como JSON-LD. */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, path = Astro.url.pathname, image, noindex = false, jsonLd = [] } =
  Astro.props;

const canonical = new URL(path, Astro.site).href;
const imageUrl = image ? new URL(image, Astro.site).href : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content="website" />
<meta property="og:locale" content="es_ES" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{imageUrl && <meta property="og:image" content={imageUrl} />}
{imageUrl && <meta property="og:image:width" content="1200" />}
{imageUrl && <meta property="og:image:height" content="630" />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}

{
  jsonLd.map((data) => (
    <script type="application/ld+json" set:html={JSON.stringify(data)} />
  ))
}
