---
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { telHref, whatsappHref } from '../lib/contact';
import { getHome, getOrderedItems, getSite } from '../lib/content';

const [site, home, values] = await Promise.all([getSite(), getHome(), getOrderedItems('values')]);
const callHref = telHref(site);
---

<BaseLayout title={site.seo.title} description={site.seo.description} path="/">
  <Header
    slot="header"
    nav={site.nav}
    name={site.name}
    phone={site.phone}
    callHref={callHref}
    callLabel={home.contact.callLabel}
  />
  <Hero
    {...home.hero}
    ctaHref="#contacto"
    phone={site.phone}
    callHref={callHref}
    values={values}
  />
  <FloatingWhatsApp href={whatsappHref(site)} label={`${home.contact.whatsappLabel}: ${home.contact.whatsappHint}`} />
</BaseLayout>
