---
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Process from '../components/Process.astro';
import Sectors from '../components/Sectors.astro';
import Solutions from '../components/Solutions.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { mailHref, telHref, whatsappHref } from '../lib/contact';
import { getHome, getOrderedItems, getSite } from '../lib/content';

const [site, home, values, services, steps, sectors] = await Promise.all([
  getSite(),
  getHome(),
  getOrderedItems('values'),
  getOrderedItems('services'),
  getOrderedItems('steps'),
  getOrderedItems('sectors'),
]);
const callHref = telHref(site);
---

<BaseLayout
  title={site.seo.title}
  description={site.seo.description}
  path="/"
  skipLabel={site.a11y.skipLink}
>
  <Header
    slot="header"
    nav={site.nav}
    name={site.name}
    a11y={site.a11y}
    phone={site.phone}
    callHref={callHref}
    callLabel={home.contact.callLabel}
  />
  <Hero
    {...home.hero}
    ctaHref="#contacto"
    phone={site.phone}
    callHref={callHref}
    values={values}
  />
  <Solutions {...home.solutions} {services} />
  <Sectors {...home.sectors} {sectors} />
  <Process {...home.process} {steps} />
  <About {...home.about} />
  <Contact
    eyebrow={home.contact.eyebrow}
    title={home.contact.title}
    highlight={home.contact.highlight}
    subtitle={home.contact.subtitle}
    hours={site.hoursLong}
    channels={[
      {
        title: home.contact.whatsappLabel,
        detail: home.contact.whatsappHint,
        href: whatsappHref(site),
        icon: 'chat',
        tone: 'whatsapp',
        external: true,
      },
      { title: home.contact.callLabel, detail: site.phone, href: callHref, icon: 'phone', tone: 'brand' },
      { title: home.contact.emailLabel, detail: site.email, href: mailHref(site), icon: 'mail', tone: 'brand' },
    ]}
  />
  <Footer slot="footer" name={site.name} tagline={site.tagline} />
  <FloatingWhatsApp href={whatsappHref(site)} label={`${home.contact.whatsappLabel}: ${home.contact.whatsappHint}`} />
</BaseLayout>
